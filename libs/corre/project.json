{
  "name": "corre",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/corre/src",
  "projectType": "library",
  "tags": ["scope:lib", "type:publishable"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build",
        "cwd": "libs/corre"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "libs/corre"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'lint corre'"
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "options": {}
    }
  }
}
