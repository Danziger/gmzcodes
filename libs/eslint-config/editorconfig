# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{js,jsx,ts,tsx,yml,html,scss,css,astro,json,mdx}]
indent_size = 2

[*.{sh,bash}]
end_of_line = lf
