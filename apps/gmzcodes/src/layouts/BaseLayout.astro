---
interface Props {
  bodyClass?: string;
}

const { bodyClass } = Astro.props;
const title = 'GMZcodes - Dani Gámez Franco';
const description =
  'Dani Gámez Franco - Staff Web3 Software Engineer / Architect - Summa Cum Laude Computer Science Engineer - Top 1.5% at StackOverflow - JS, TS, React, Next.js, Node.js, tRPC, Clean Software Architecture';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://gmzcodes.com/og-images/dani-gamez-franco-personal-website.png" />
    <meta property="og:image:width" content="3000" />
    <meta property="og:image:height" content="1570" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content="https://gmzcodes.com/" />

    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://gmzcodes.com/og-images/dani-gamez-franco-personal-website.png" />
    <meta name="twitter:site" content="https://gmzcodes.com/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@gmzcodes" />

    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Dani Gámez Franco" />
    <meta name="screen-orientation" content="portrait" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no"
    />

    <link rel="canonical" href={Astro.url.pathname === '/' ? 'https://gmzcodes.com' : Astro.url.href} />
    <meta name="theme-color" content="white" />

    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="/logo/gmzcodes-t-e-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logo/gmzcodes-s-e-180.png" />

    <meta name="google-site-verification" content="UylIr5AFjfxJObGXbDFnAg_2BC7U0Cz1ymt42TCuYKY" />
    <meta name="msvalidate.01" content="4ADB0FF9E47FA748DC6A9CAE54DA4302" />
    <link rel="preconnect" href="https://plausible.io" />
    <script defer data-domain="gmzcodes.com" src="https://plausible.io/js/plausible.js"></script>

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preload" href="https://fonts.googleapis.com/css?family=Cardo:700|Josefin+Sans&display=swap" as="style" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css?family=Cardo:700|Josefin+Sans&display=swap"
      media="print"
      onload="this.media='all'"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'http://schema.org',
      '@type': 'Person',
      name: 'Dani Gámez Franco',
      url: 'https://gmzcodes.com',
      jobTitle: 'Staff Web3 Software Engineer / Architect',
      alumniOf: 'Autonomous University of Barcelona',
      gender: 'male',
      image: 'https://s.gravatar.com/avatar/ff1de7f1a325c8005379a310949f7f23?s=512',
      sameAs: [
        'https://www.linkedin.com/in/danigamezfranco',
        'https://stackoverflow.com/users/3723993/danziger',
        'https://github.com/danziger',
        'https://twitter.com/gmzcodes',
      ],
    })} />

    <slot name="head" />
  </head>
  <body class:list={[bodyClass]}>
    <slot />
  </body>
</html>

<style is:global lang="scss">
  @use '../styles/portfolio-global.scss';
</style>
