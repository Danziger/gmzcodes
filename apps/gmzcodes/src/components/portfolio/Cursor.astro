---
import cursorStyles from '../../legacy/app/components/cursor/cursor.module.scss';
---

<div class={cursorStyles.root} style="transform: translate(-128px, -128px);" data-portfolio="cursor-root">
  <div class={cursorStyles.rulerHorizontalPrimary}></div>
  <div class={cursorStyles.rulerHorizontalSecondary}></div>
  <div class={cursorStyles.rulerVerticalPrimary}></div>
  <div class={cursorStyles.rulerVerticalSecondary}></div>
  <div class={cursorStyles.brush}></div>
  <div class={cursorStyles.position} data-position-label="0, 0" data-portfolio="cursor-position"></div>
</div>
